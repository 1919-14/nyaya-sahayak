# ---------------------------------------------------------------------------
# LLM provider — this project talks to ANY OpenAI-compatible /chat/completions
# endpoint, so swapping providers is a matter of editing these three lines
# and restarting the backend. No code changes needed.
# ---------------------------------------------------------------------------

# Groq (default) — https://console.groq.com/keys
LLM_API_KEY=your_groq_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# --- Examples for other providers (uncomment/edit ONE set) -----------------
# OpenAI:
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
#
# OpenRouter:
# LLM_API_KEY=sk-or-...
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct
#
# Local (Ollama/vLLM exposing an OpenAI-compatible route):
# LLM_API_KEY=not-needed-but-must-be-non-empty
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.3
# -----------------------------------------------------------------------------

# Optional — enables the live web fallback when local retrieval confidence is low
TAVILY_API_KEY=
